{
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "windows-release",
      "description": "Default Windows Build",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "description": "Build Windows Release",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "description": "Build Windows Debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-diagnostics",
      "configurePreset": "windows-diagnostics",
      "description": "Build Windows Diagnostics",
      "configuration": "Debug"
    },
    {
      "name": "windows-debug-asan",
      "configurePreset": "windows-debug-asan",
      "description": "Build Windows Debug with AddressSanitizer",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "description": "Build Linux Debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "description": "Build Linux Release"
    }
  ],
  "configurePresets": [
    {
      "name": "windows-default",
      "inherits": "windows-release",
      "displayName": "Windows Release (default)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CV_WARNING_FLAGS": "/W4",
        "CV_FORCE_LOGS": "ON",
        "BUILD_TESTING": "ON"
      },
      "architecture": "x64",
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CV_WARNING_FLAGS": "/W4",
        "BUILD_TESTING": "ON"
      },
      "architecture": "x64",
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug-asan",
      "displayName": "Windows x64 Debug with ASan",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/windows-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "/fsanitize=address",
        "CMAKE_CXX_FLAGS": "/fsanitize=address",
        "BUILD_TESTING": "ON"
      },
      "architecture": "x64",
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-diagnostics",
      "displayName": "Windows Diagnostics",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/windows-diagnostics",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CV_DIAGNOSTIC_BUILD": "ON",
        "BUILD_TESTING": "ON"
      },
      "architecture": "x64",
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GLFW_BUILD_WAYLAND": "OFF",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GLFW_BUILD_WAYLAND": "OFF",
        "CV_FORCE_LOGS": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "version": 4
}
