<!DOCTYPE html>
<html lang="en" class="theme-auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {% set pageTitle = title ? title + " · " + site.shortTitle : site.title %}
  <title>{{ pageTitle }}</title>
  {% set pageDescription = description or summary or site.description %}
  <meta name="description" content="{{ pageDescription }}" />
  <meta name="author" content="{{ site.author }}" />
  {% set canonicalUrl = (site.url or '') + page.url %}
  <link rel="canonical" href="{{ canonicalUrl }}" />
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml" />
  {% set socialImage = cover or hero or '/assets/BlackFrameBanner.jpg' %}
  {% set socialImageAbsolute = socialImage startsWith('http') ? socialImage : (site.url + socialImage) %}
  <meta property="og:title" content="{{ title or site.title }}" />
  <meta property="og:description" content="{{ pageDescription }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ site.shortTitle }}" />
  <meta property="og:image" content="{{ socialImageAbsolute }}" />
  <meta property="og:image:alt" content="{{ title or site.title }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or site.title }}" />
  <meta name="twitter:description" content="{{ pageDescription }}" />
  <meta name="twitter:image" content="{{ socialImageAbsolute }}" />
  {% if site.twitter %}
  <meta name="twitter:site" content="{{ site.twitter }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f7f8fa;
      --fg: #101320;
      --muted: #4f5564;
      --accent: #2d9cdb;
      --card-bg: #ffffff;
      --border: rgba(16, 19, 32, 0.08);
      --code-bg: #f1f3f9;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #05060a;
        --fg: #f7f9fc;
        --muted: #a0a6b8;
        --accent: #4db3ff;
        --card-bg: #101320;
        --border: rgba(247, 249, 252, 0.08);
        --code-bg: #111827;
      }
    }

    html[data-theme="light"] {
      --bg: #f7f8fa;
      --fg: #101320;
      --muted: #4f5564;
      --accent: #2d9cdb;
      --card-bg: #ffffff;
      --border: rgba(16, 19, 32, 0.08);
      --code-bg: #f1f3f9;
    }

    html[data-theme="dark"] {
      --bg: #05060a;
      --fg: #f7f9fc;
      --muted: #a0a6b8;
      --accent: #4db3ff;
      --card-bg: #101320;
      --border: rgba(247, 249, 252, 0.08);
      --code-bg: #111827;
    }

    body {
      margin: 0;
      font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--fg);
      transition: background 0.3s ease, color 0.3s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a.link {
      color: var(--accent);
    }

    .site-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header.site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 5vw, 4rem);
    }

    .site-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      font-weight: 600;
      font-size: 1rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .site-brand img {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    }

    nav.site-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.95rem;
      font-weight: 500;
    }

    .theme-toggle {
      border: 1px solid var(--border);
      background: transparent;
      color: var(--fg);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .theme-toggle:hover {
      background: rgba(45, 156, 219, 0.12);
      border-color: rgba(45, 156, 219, 0.4);
    }

    main.site-main {
      flex: 1;
      padding: 0 clamp(1.25rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    }

    .content-wrapper {
      max-width: 70ch;
      margin: 0 auto;
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .content-wrapper p {
      margin-bottom: 1.35rem;
    }

    .content-wrapper img {
      width: 100%;
      border-radius: 12px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      box-shadow: 0 10px 32px rgba(0,0,0,0.12);
      margin: 2rem 0;
    }

    .posts-grid {
      display: grid;
      gap: 2rem;
    }

    @media (min-width: 960px) {
      .posts-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .post-card {
      background: var(--card-bg);
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .post-card__link {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .post-card__media img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .post-card__body {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .post-card__title {
      margin: 0;
      font-size: 1.5rem;
      letter-spacing: -0.01em;
    }

    .post-card__summary {
      color: var(--muted);
      margin: 0;
      font-size: 1rem;
    }

    .post-card__meta {
      display: flex;
      gap: 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
      align-items: center;
    }

    .post-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 30px 80px rgba(15, 23, 42, 0.24);
    }

    pre {
      background: var(--code-bg);
      padding: 1.25rem;
      border-radius: 12px;
      overflow-x: auto;
      font-size: 0.95rem;
      border: 1px solid var(--border);
    }

    code {
      font-family: "JetBrains Mono", "Fira Code", "SFMono-Regular", Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    footer.site-footer {
      padding: 3rem clamp(1.25rem, 5vw, 4rem) 4rem;
      font-size: 0.9rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }

    footer.site-footer a {
      color: var(--accent);
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      color: var(--muted);
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid var(--border);
      padding: 0.2rem 0.75rem;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .post-header {
      margin-bottom: 2rem;
    }

    .post-header h1 {
      margin-bottom: 0.75rem;
      font-size: clamp(2.2rem, 5vw, 2.8rem);
      letter-spacing: -0.02em;
    }

    .intro-eyebrow {
      font-size: 0.75rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .post-summary {
      font-size: 1.25rem;
      color: var(--muted);
      margin-top: 1rem;
    }

    @media (max-width: 720px) {
      header.site-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
      }

      nav.site-nav {
        width: 100%;
        justify-content: space-between;
      }

      main.site-main {
        padding-top: 1rem;
      }

      .post-card__media img {
        height: 180px;
      }
    }
  </style>
  <!-- Google Analytics 4 placeholder -->
  <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXX');
  </script> -->
</head>
<body>
  <script>
    (function() {
      const storedTheme = localStorage.getItem('bf-theme');
      if (storedTheme) {
        document.documentElement.setAttribute('data-theme', storedTheme);
      }
    })();
  </script>
  <div class="site-shell">
    <header class="site-header">
      <a class="site-brand" href="/posts/" aria-label="BlackFrame AI Lab Journal home">
        <img src="/assets/blackflamelogo.png" alt="BlackFrame AI logo" loading="lazy" />
        <span>{{ site.shortTitle }}</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a class="link" href="/">Studio Home</a>
        <a class="link" href="/posts/">Blog</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <span aria-hidden="true">☀️</span>
          <span class="toggle-label">Light</span>
        </button>
      </nav>
    </header>
    <main class="site-main">
      {% block content %}{% endblock %}
    </main>
    <footer class="site-footer">
      <div>© {{ "now" | date("%Y") }} {{ site.shortTitle }}. All rights reserved.</div>
      <div>
        Subscribe via <a href="/feed.xml">RSS</a> • Sitemap: <a href="/sitemap.xml">/sitemap.xml</a>
      </div>
    </footer>
  </div>
  <script>
    const toggle = document.getElementById('theme-toggle');
    const label = toggle?.querySelector('.toggle-label');
    const root = document.documentElement;

    function setTheme(next) {
      root.setAttribute('data-theme', next);
      localStorage.setItem('bf-theme', next);
      if (label) {
        label.textContent = next === 'dark' ? 'Dark' : 'Light';
      }
      if (toggle) {
        toggle.querySelector('span[aria-hidden="true"]').textContent = next === 'dark' ? '🌙' : '☀️';
      }
    }

    function getPreferredTheme() {
      const stored = localStorage.getItem('bf-theme');
      if (stored) return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    const initial = getPreferredTheme();
    setTheme(initial);

    toggle?.addEventListener('click', () => {
      const current = root.getAttribute('data-theme') || initial;
      const next = current === 'dark' ? 'light' : 'dark';
      setTheme(next);
    });
  </script>
</body>
</html>
